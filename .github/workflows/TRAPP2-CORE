# ============================================================
#  >>> DESTINATION: TheMostLocal/TRAPP2-CORE
#  >>> FILE PATH:   .github/workflows/check.yml
#  z161.2 - optional safety check (TRAPP2-CORE needs no workflow to work: the four books' workflows check it out
#  and run its scripts). Every book picks up whatever is committed here, so on each push this confirms that every
#  script parses and every file the books expect is present - a broken or missing file shows up here, red, before
#  the books' next pass uses it (10-26: 14 files never committed; a bash script saved as a .py in TRAPP2-3).
# ============================================================
name: Check the shared pipeline

on:
  push:
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  check:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - name: Every expected file is here and parses
        run: |
          set -e
          for f in append_intraday_snapshot.py build_history.py classify_regime.py cleanup_history_orphans.py \
                   compute_signals.py compute_transitions.py fetch_ceo_tracker.py fetch_company_facts.py \
                   fetch_etf_holdings.py fetch_history.py fetch_intraday_bars.py fetch_quotes_fast.py \
                   human_corrections.py intraday_loop.sh intraday_session.py merge_manifest.py \
                   alpaca_data.py supabase_live.py lib/__init__.py; do
            [ -f "pipeline/$f" ] || { echo "::error::missing pipeline/$f"; exit 1; }
          done
          for f in pipeline/*.py pipeline/lib/*.py; do python -m py_compile "$f" || { echo "::error::$f does not parse"; exit 1; }; done
          for f in pipeline/*.sh; do bash -n "$f" || { echo "::error::$f does not parse"; exit 1; }; done
          echo "TRAPP2-CORE: $(ls pipeline/*.py pipeline/*.sh pipeline/lib/*.py | wc -l) files, all present, all parse"
